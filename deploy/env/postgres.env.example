# The bundled Postgres (only with COMPOSE_PROFILES=bundled-db). Copy to deploy/env/postgres.env.
# These are read only when the data directory is first created; changing them later does not change the database.
POSTGRES_DB=cbz_helpengine
POSTGRES_USER=postgres
# must equal POSTGRES_PASSWORD in deploy/env/helpengine.env
POSTGRES_PASSWORD=CHANGE_ME
