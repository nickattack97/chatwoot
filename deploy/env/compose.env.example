# Docker Compose settings for this host. Copy to .env next to docker-compose.production.yaml (not into the containers).
# bundled-db runs Postgres in a container on this host; leave it out when POSTGRES_HOST points at a database server.
COMPOSE_PROFILES=bundled-db
# the host's nginx proxies to it; never 0.0.0.0
HELPENGINE_BIND=127.0.0.1
HELPENGINE_PORT=3000
# Host-only ports for operators (psql, pg_dump, redis-cli). Change them if another stack on this host already uses them.
HELPENGINE_PG_PUBLISH=127.0.0.1:5432
HELPENGINE_REDIS_PUBLISH=127.0.0.1:6379
