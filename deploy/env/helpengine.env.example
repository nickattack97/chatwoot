# Rails, Sidekiq and the migrate job (docker-compose.production.yaml). Copy to deploy/env/helpengine.env and fill in.
# scripts/check-env.sh all   lists anything missing or still CHANGE_ME, by name only. Never commit the real file.

# ── Core ──
# openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME
# The URL people open, including the DMZ sub-path: UAT and production each have their own.
# e.g. https://pg.cbz.co.zw/helpengine
FRONTEND_URL=CHANGE_ME
ENABLE_ACCOUNT_SIGNUP=false
# TLS ends at the host's nginx
FORCE_SSL=false
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5
# Puma workers; single mode (0/1) is too small for agent load
WEB_CONCURRENCY=4

# ── Database (bundled: POSTGRES_HOST=postgres and COMPOSE_PROFILES=bundled-db in .env) ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=cbz_helpengine
POSTGRES_USERNAME=postgres
# bundled: must equal deploy/env/postgres.env
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis ──
REDIS_URL=redis://redis:6379
# must equal deploy/env/redis.env
REDIS_PASSWORD=CHANGE_ME

# ── Encryption (MFA and other encrypted columns). Generate once per environment: rails db:encryption:init ──
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=CHANGE_ME
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=CHANGE_ME
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=CHANGE_ME

# ── Files ──
# the storage_data volume
ACTIVE_STORAGE_SERVICE=local

# ── Mail (CBZ relay) ──
MAILER_SENDER_EMAIL=Contact Centre <contactcentre@cbz.co.zw>
SMTP_DOMAIN=cbz.co.zw
SMTP_ADDRESS=CHANGE_ME
SMTP_PORT=25
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_AUTHENTICATION=

ENABLE_PUSH_RELAY_SERVER=true

# ── CBZ integrations ──
# Private hosts Chatwoot may call despite its SSRF guard (host:port), e.g. the WA-Bot-Engine Kestrel port for this environment.
SAFE_FETCH_ALLOWED_INTERNAL_HOSTS=CHANGE_ME
# UserConnect portal (password change link). The SSO itself is configured in Super Admin, not here.
UC_PORTAL_URL=CHANGE_ME
# Optional: 360dialog's Cloud API for inboxes with api_host 360dialog (defaults to https://waba-v2.360dialog.io)
# WHATSAPP_360DIALOG_CLOUD_BASE_URL=
